{
   "compilerOptions": {
     "target": "ES2020",
     "module": "commonjs",
     "moduleResolution": "node",
     "ignoreDeprecations": "6.0",
     "strict": true,
     "esModuleInterop": true,
     "skipLibCheck": true,
     "outDir": "./dist"
   },
   "include": [
     "tests/**/*.ts",
     "pages/**/*.ts",
     "fixtures/**/*.ts",
     "utils/**/*.ts",
     "playwright.config.ts"
   ]
 }